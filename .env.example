# LOCAL SENTINEL ONLY. Never deploy this environment file with demo-target.
# npm run setup generates these two random tokens. Keep both private.
SENTINEL_OPERATOR_TOKEN=
TARGET_PROBE_TOKEN=
SENTINEL_DB_PATH=data/sentinel.sqlite
SENTINEL_PUBLIC_URL=
PORT=3000

# Live AI diagnosis (required in live mode; sandbox never calls a model)
AI_GATEWAY_API_KEY=
AI_MODEL=openai/gpt-6-astra-fast

# Slack
SLACK_BOT_TOKEN=
SLACK_INCIDENT_CHANNEL_ID=
SLACK_SIGNING_SECRET=
SLACK_TEAM_ID=

# Vercel
VERCEL_ACCESS_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
VERCEL_KNOWN_GOOD_DEPLOYMENT_ID=
TARGET_PRODUCTION_URL=
# Optional if Vercel deployment protection is enabled for the demo project.
VERCEL_PROTECTION_BYPASS=

# GitHub (owner/repository)
GITHUB_TOKEN=
GITHUB_REPOSITORY=

# Linear
LINEAR_API_KEY=
LINEAR_TEAM_ID=

# Two separate switches. Enabling LIVE_MODE_ENABLED permits real API reads,
# model spend, Slack messages, and GitHub/Linear issue creation.
LIVE_MODE_ENABLED=false
# Additionally permits rollback of ONLY the configured disposable Vercel project.
ALLOW_PRODUCTION_ACTIONS=false
